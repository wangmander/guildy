# ============================================================
# Guildy Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# OpenAI (extract-jd.ts only)
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic (Quick Prep + Deep Prep)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# NextAuth (for Google OAuth)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-secret-here

# Google OAuth (for Gmail access)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# PostHog (Phase 6.5 — analytics)
# When NEXT_PUBLIC_POSTHOG_KEY is unset, all capture calls no-op gracefully.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Termly (Phase 6.5 — legal pages)
# Generate the policies on termly.io and paste the embed UUIDs here.
NEXT_PUBLIC_TERMLY_TOS_ID=TODO_TERMLY_TOS_ID
NEXT_PUBLIC_TERMLY_PRIVACY_ID=TODO_TERMLY_PRIVACY_ID

# Stripe (Phase 6b — paid subscriptions)
# Test keys start with sk_test_/pk_test_; live keys start with sk_live_/pk_live_.
# STRIPE_PRICE_ID is the recurring monthly $19.99 price object created in the
# Stripe dashboard. STRIPE_WEBHOOK_SECRET is provisioned per webhook endpoint
# (locally via `stripe listen --forward-to localhost:3000/api/stripe/webhook`,
# in production via the Stripe dashboard webhooks page).
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
STRIPE_PRICE_ID=price_your_recurring_monthly_price_id_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
